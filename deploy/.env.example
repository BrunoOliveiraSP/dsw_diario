# Copie para .env e ajuste os valores: cp .env.example .env

# Fuso horário (a regra "sem anotações com data futura" depende dele)
TZ=America/Sao_Paulo

# Banco de dados
DB_NAME=diario
DB_USER=root
DB_PASSWORD=root
# "mysql" é o nome do serviço no docker-compose
DB_URL=jdbc:mysql://mysql:3306/diario?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=America/Sao_Paulo

# JWT (segredo com no mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-bem-grande-e-aleatorio
JWT_EXPIRACAO=120

# Portas expostas na sua máquina
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Front-end: endereço da API visto pelo NAVEGADOR (por isso localhost, e não "backend")
API_URL=http://localhost:8080
# Back-end: origens autorizadas a chamar a API (endereço do front-end)
CORS_ORIGINS=http://localhost:4200
